read_file -type verilog ../rtl/FSM_CU_TX.v
read_file -type verilog ../rtl/Integer_CLK_DIV.v
read_file -type verilog ../rtl/Multi_FF.v
read_file -type verilog ../rtl/MUX_TX.v
read_file -type verilog ../rtl/parallel_2_serial_TX.v
read_file -type verilog ../rtl/Parity_check_RX.v
read_file -type verilog ../rtl/Parity_gen_TX.v

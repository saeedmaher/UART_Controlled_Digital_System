source -echo ./cons.tcl
# Constraints
# ----------------------------------------------------------------------------
#
# 1. Master Clock Definitions
#
# 2. Generated Clock Definitions
#
# 3. Clock Uncertainties
#
# 4. Clock Latencies 
#
# 5. Clock Relationships
#
# 6. set input/output delay on ports
#
# 7. Driving cells
#
# 8. Output load
####################################################################################
#########################################################
#### Section 1 : Clock Definition ####
#########################################################
#################################################################################### 
# 1. Master Clock Definitions 
# 2. Generated Clock Definitions
# 3. Clock Latencies
# 4. Clock Uncertainties
# 5. Clock Transitions
####################################################################################
set REF_CLK_PER 20
set UART_CLK_PER 217.267
set SCAN_CLK_PER 100
set CLK_SETUP_SKEW 0.2
set CLK_HOLD_SKEW 0.1
set CLK_LAT 0
set CLK_TRANS 0.05
# Maseter clocks
#---------------------------------------------------------------------------
create_clock -period $REF_CLK_PER -name MASTER_REF_CLK [get_ports REF_CLK]
create_clock -period $UART_CLK_PER -name MASTER_UART_CLK [get_ports UART_CLK]
create_clock -period $SCAN_CLK_PER -name SCAN_CLK [get_ports Scan_CLK]
Warning: Can't find port 'Scan_CLK' in design 'SYS_TOP'. (UID-95)
Error: Value for list 'source_objects' must have 1 elements. (CMD-036)
# Generated clocks
#---------------------------------------------------------------------------
#ALU clock
create_generated_clock -master_clock MASTER_REF_CLK 			-source [get_ports REF_CLK] 			-name GENERATED_ALU_CLK 			-divide_by 1 [get_ports ICG0/gated_clk]
#UART Tx clock
create_generated_clock -master_clock MASTER_UART_CLK 			-source [get_ports UART_CLK] 			-name GENERATED_TX_CLK 			-divide_by 32 [get_ports CLK_DIV0/o_div_clk]
#UART Rx clock
create_generated_clock -master_clock MASTER_UART_CLK 			-source [get_ports UART_CLK] 			-name GENERATED_RX_CLK 			-divide_by 1 [get_ports CLK_DIV1/o_div_clk]			
# uncertainty + latency
#---------------------------------------------------------------------------
set_clock_uncertainty -setup $CLK_SETUP_SKEW [get_clocks {MASTER_REF_CLK MASTER_UART_CLK GENERATED_ALU_CLK GENERATED_TX_CLK GENERATED_RX_CLK SCAN_CLK}]		   
Warning: Can't find clock 'SCAN_CLK' in design 'SYS_TOP'. (UID-95)
set_clock_uncertainty -hold $CLK_HOLD_SKEW [get_clocks {MASTER_REF_CLK MASTER_UART_CLK GENERATED_ALU_CLK GENERATED_TX_CLK GENERATED_RX_CLK SCAN_CLK}]		   
Warning: Can't find clock 'SCAN_CLK' in design 'SYS_TOP'. (UID-95)
set_clock_latency 0 [get_clocks {MASTER_REF_CLK MASTER_UART_CLK GENERATED_ALU_CLK GENERATED_TX_CLK GENERATED_RX_CLK SCAN_CLK}]
Warning: Can't find clock 'SCAN_CLK' in design 'SYS_TOP'. (UID-95)
# Transation
#---------------------------------------------------------------------------
set_clock_transition $CLK_TRANS [get_clocks {MASTER_REF_CLK MASTER_UART_CLK GENERATED_ALU_CLK GENERATED_TX_CLK GENERATED_RX_CLK SCAN_CLK}]
Warning: Can't find clock 'SCAN_CLK' in design 'SYS_TOP'. (UID-95)
# Don not touch network
#---------------------------------------------------------------------------
set_dont_touch_network [get_clocks {MASTER_REF_CLK MASTER_UART_CLK GENERATED_ALU_CLK GENERATED_TX_CLK GENERATED_RX_CLK SCAN_CLK}]
Warning: Can't find clock 'SCAN_CLK' in design 'SYS_TOP'. (UID-95)
####################################################################################
#########################################################
#### Section 2 : Clocks Relationships ####
#########################################################
####################################################################################
set_clock_groups -asynchronous -group [get_clocks {MASTER_UART_CLK GENERATED_TX_CLK GENERATED_RX_CLK}] 				-group [get_clocks {MASTER_REF_CLK GENERATED_ALU_CLK}] 				-group [get_clocks SCAN_CLK]
Warning: Can't find clock 'SCAN_CLK' in design 'SYS_TOP'. (UID-95)
Error: Value for list '-group' must have 1 elements. (CMD-036)
####################################################################################

# UART CLK
set in_delay_uart  [expr 0.2*$UART_CLK_PER]
set out_delay_uart [expr 0.2*$UART_CLK_PER]
# Scan CLK
set in_delay_scan  [expr 0.2*$SCAN_CLK_PER]
set out_delay_scan [expr 0.2*$SCAN_CLK_PER]
#Constrain Input Paths
set_input_delay $in_delay_uart -clock MASTER_UART_CLK [get_ports UART_RX_IN]
set_input_delay $in_delay_scan -clock SCAN_CLK [get_ports SI]
Warning: Can't find clock 'SCAN_CLK' in design 'SYS_TOP'. (UID-95)
